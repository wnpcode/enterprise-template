{
  "name": "enterprise-template",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "storybook": "pnpm --filter @wnp_code/design-system storybook",
    "build-storybook": "pnpm --filter @wnp_code/design-system build-storybook",
    "dev": "pnpm --filter playground dev",
    "dev:web": "pnpm --filter web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter web e2e",
    "prepare": "husky",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm --filter @wnp_code/design-system build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
